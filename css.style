/* General Styling */
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body{
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    color: #333;
    line-height: 1.6;
}

/* Header */
header{
    background-color: #003366;
    color: white;
    text-align: center;
    padding: 30px;
}

header h1{
    font-size: 36px;
}

header p{
    font-size: 18px;
}

/* Navigation Bar */
nav{
    background-color: #00066;
    text-align: center;
    padding: 15px;
}

nav a{
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-size: 18px;
    font-weight: bold;
}

nav a:hover{
    color: yellow;
}

/* Profile Picture */
.profile-picture{
    text-align: center;
    margin: 20px 0;
}

.profile-picture img{
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 4px solid #003366;
    object-fit: cover;
}

/* Sections */
section,
.container{
    width: 80%;
    max-width: 1000px;
    margin: 20px auto;
    background-color: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

h2{
    color: #003366;
    margin-bottom: 15px;
}

h3{
    color: #0055aa;
    margin-bottom: 10px;
}

/* Projects */
.project{
    margin-bottom: 20px;
    padding: 15px;
    border-left: 5px solid #003366;
    background-color: #f9f9f9;
}

/* Buttons */
.btn,
button{
    display: inline-block;
    background-color: #003366;
    color: white;
    padding: 10px 20px;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.btn:hover,
button:hover{
    background-color: #0055aa;
}

/* Forms */
input,
textarea{
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

label{
    font-weight: bold;
}

/* Footer */
footer{
    background-color: #003366;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
}